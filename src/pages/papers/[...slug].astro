---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../components/layout/PageLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import DocPreviewGate from '../../components/docs/DocPreviewGate.astro';
import RightToc from '../../components/docs/RightToc.astro';
import { tagSlug } from '../../config/tags';
export async function getStaticPaths(){
  const entries=(await getCollection('papers')).filter(e=>!e.data.draft).sort((a,b)=>a.data.order-b.data.order);
  return entries.map(entry=>({params:{slug:entry.id},props:{entry}}));
}
const {entry}=Astro.props;
const {Content,headings}=await render(entry);
---
<PageLayout title={entry.data.title+' | LLMNotes'} description={entry.data.description}>
  <div class="docs-layout docs-layout-article">
    <article class="doc-main" data-pagefind-body>
      <Breadcrumb items={[{label:'论文研读',href:'/papers'},{label:entry.data.title,href:Astro.url.pathname}]}/>
      <header class="doc-header">
        <span class="doc-kicker">论文研读 / LONGFORM NOTES</span>
        <h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p>
        <div class="meta"><span>{entry.data.difficulty}</span><span>{entry.data.updated.toISOString().slice(0,10)} 更新</span><span>{entry.data.readingTime||'约 8 分钟'}</span></div>
        <div class="tags">{entry.data.tags.map(tag=><a class="tag" href={'/tags/'+tagSlug(tag)}>{tag}</a>)}</div>
      </header>
      <DocPreviewGate unlockRequired={entry.data.unlockRequired}><Content/></DocPreviewGate>
      <div class="article-end"><a href="/papers">← 返回论文研读</a></div>
    </article><RightToc headings={headings}/>
  </div>
</PageLayout>
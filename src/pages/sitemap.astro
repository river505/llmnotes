---
import PageLayout from '../components/layout/PageLayout.astro';
import { categories, navItems } from '../config/site';
const paths=[
{label:'技术文档',href:'/docs',description:'从输入表示、注意力和训练目标进入现代大模型的计算机制。'},
{label:'学习路线',href:'/roadmaps',description:'围绕模型学习、应用开发与研究方法，形成可验收的学习产物。'},
{label:'论文研读',href:'/papers',description:'追溯经典模型、效率优化、偏好学习与多模态的原始方法。'},
{label:'项目实践',href:'/projects',description:'从数据、工具、测试和成本分析构建可以验证的系统。'},
{label:'技术面试',href:'/interview',description:'用原理推导、资源取舍和实验设计回答技术深问。'},
{label:'资源索引',href:'/resources',description:'官方文档、开源项目与论文评估的常用技术入口。'}
];
---
<PageLayout title="内容地图 | LLMNotes" description="LLMNotes 文档、论文、项目、学习路线与技术资源索引。">
  <section class="page-intro"><span class="overline">SITE INDEX / READING MAP</span><h1>内容地图</h1><p class="lead">按技术问题和阅读目标找到对应的长文、项目与参考资料。不同入口覆盖模型机制、论文方法和系统工程三个层面。</p></section>
  <section class="editorial-section"><div class="topic-grid">{paths.map((item,i)=><a class="topic-card" href={item.href}><span class="topic-index">{String(i+1).padStart(2,'0')}</span><div><h3>{item.label}</h3><p>{item.description}</p></div><span class="topic-arrow">↗</span></a>)}</div></section>
  <section class="editorial-section ruled"><div class="section-title-row"><div><span class="overline">SUBJECTS / TECHNICAL AREAS</span><h2>专题入口</h2></div></div><div class="topic-grid">{categories.map((item,i)=><a class="topic-card" href={item.href}><span class="topic-index">{String(i+1).padStart(2,'0')}</span><div><h3>{item.title}</h3><p>{item.description}</p></div><span class="topic-arrow">↗</span></a>)}</div></section>
</PageLayout>
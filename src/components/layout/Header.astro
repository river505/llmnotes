---
import { SITE_NAME } from '../../consts';
import { navItems } from '../../config/site';
const path = Astro.url.pathname;
---
<header class="site-header">
  <a class="brand" href="/" aria-label="LLMNotes 首页"><span class="brand-mark">LN</span><span class="brand-wordmark">{SITE_NAME}<small>RESEARCH & ENGINEERING</small></span></a>
  <nav class="desktop-nav" aria-label="主导航">
    {navItems.map(item => <a class:list={[path === item.href || (item.href !== '/' && path.startsWith(item.href)) ? 'nav-active' : '']} href={item.href}>{item.label}</a>)}
  </nav>
  <div class="header-actions">
    <button class="icon-button search-trigger" type="button" aria-label="打开站内搜索" title="搜索 Ctrl / ⌘ + K"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10.5" cy="10.5" r="6.7"/><path d="m15.5 15.5 5 5"/></svg></button>
    <button class="icon-button theme-toggle" type="button" aria-label="切换深浅主题" title="切换主题">◐</button>
    <button class="icon-button menu-toggle" type="button" aria-label="展开导航" aria-expanded="false" title="导航">☰</button>
  </div>
</header>
<div class="mobile-panel" id="mobile-panel" hidden>{navItems.map(item=><a href={item.href}>{item.label}</a>)}<a href="/resources">资源索引</a><a href="/about">关于本站</a></div>
<div class="search-modal" id="search-modal" hidden role="dialog" aria-modal="true" aria-label="搜索 LLMNotes">
  <div class="search-backdrop" data-close-search></div>
  <section class="search-panel"><div class="search-head"><div><span class="overline">SEARCH / KNOWLEDGE BASE</span><strong>搜索技术文档</strong></div><button class="icon-button" type="button" data-close-search aria-label="关闭搜索">×</button></div>
    <input id="site-search-input" class="search-input" type="search" placeholder="Attention、RAG 评测、KV Cache、论文..." autocomplete="off" />
    <div class="quick-tags">{['Transformer','KV Cache','RAG','Agent','LoRA','PPO'].map(tag=><button type="button" data-search-keyword={tag}>{tag}</button>)}</div>
    <div id="search-results" class="search-results"><p class="muted">输入机制、算法或论文名称，搜索对应章节。</p></div>
    <p class="search-shortcut">ESC 关闭 · Ctrl / ⌘ + K 打开</p>
  </section>
</div>
<script is:inline>
(() => {
  const root=document.documentElement;
  document.querySelector('.theme-toggle')?.addEventListener('click',()=>{
    root.classList.toggle('dark');
    try {localStorage.setItem('theme',root.classList.contains('dark')?'dark':'light');} catch {}
  });
  const menu=document.querySelector('.menu-toggle');
  const mobile=document.getElementById('mobile-panel');
  menu?.addEventListener('click',()=>{
    const open=mobile.hasAttribute('hidden');
    mobile.toggleAttribute('hidden',!open);
    menu.setAttribute('aria-expanded',String(open));
  });
  const modal=document.getElementById('search-modal');
  const input=document.getElementById('site-search-input');
  const results=document.getElementById('search-results');
  const fallback=[
    ['Token 与分词','/docs/llm-basics/tokenizer','模型基础'],
    ['四个 Token 推导 Attention','/docs/transformer/attention-four-tokens','Transformer'],
    ['KV Cache 的显存与延迟','/docs/transformer/kv-cache','Transformer'],
    ['GQA 与 MLA','/docs/transformer/gqa-mla','Transformer'],
    ['RAG 的系统链路','/docs/rag/what-is-rag','RAG'],
    ['检索与生成评测','/docs/rag/evaluation','RAG'],
    ['工具调用与状态机','/docs/agent/tool-execution','Agent'],
    ['FlashAttention','/papers/flashattention','论文研读'],
    ['LoRA','/papers/lora','论文研读']
  ];
  const escapeHtml=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  async function runSearch(raw) {
    const q=raw.trim();
    if (!q){results.innerHTML='<p class="muted">输入关键词后展示结果。</p>';return;}
    try {
      if(!window.__pagefind)window.__pagefind=await import('/pagefind/pagefind.js');
      const found=await window.__pagefind.search(q);
      const data=await Promise.all(found.results.slice(0,8).map(x=>x.data()));
      if(data.length){
        results.innerHTML=data.map(x=>'<a class="search-result" href="'+escapeHtml(x.url)+'"><strong>'+escapeHtml(x.meta?.title||'')+'</strong><span>'+escapeHtml((x.excerpt||'').replace(/<[^>]*>/g,''))+'</span></a>').join('');
        return;
      }
    }catch{}
    const matched=fallback.filter(([title,,section])=>(title+' '+section).toLowerCase().includes(q.toLowerCase()));
    results.innerHTML=matched.length?matched.map(([t,u,s])=>'<a class="search-result" href="'+escapeHtml(u)+'"><strong>'+escapeHtml(t)+'</strong><span>'+escapeHtml(s)+'</span></a>').join(''):'<p class="muted">尚无匹配的章节。可以换一个机制或算法名称。</p>';
  }
  const open=()=>{modal.hidden=false;mobile?.setAttribute('hidden','');menu?.setAttribute('aria-expanded','false');setTimeout(()=>input?.focus(),0);};
  const close=()=>{modal.hidden=true;};
  document.querySelectorAll('.search-trigger').forEach(btn=>btn.addEventListener('click',open));
  document.querySelectorAll('[data-close-search]').forEach(btn=>btn.addEventListener('click',close));
  document.querySelectorAll('[data-search-keyword]').forEach(btn=>btn.addEventListener('click',()=>{input.value=btn.dataset.searchKeyword;runSearch(input.value);}));
  input?.addEventListener('input',e=>runSearch(e.target.value));
  document.addEventListener('keydown',e=>{
    if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();open();}
    if(e.key==='Escape'&&!modal.hidden)close();
  });
})();
</script>
---
const { unlockRequired = true } = Astro.props;
---
<div class="doc-gate" data-doc-gate data-unlock-required={String(unlockRequired)}>
  <div class="prose doc-content collapsed" data-doc-content><slot /></div>
  {unlockRequired && <div class="doc-fade" data-doc-fade><div class="unlock-card"><p>为了减少批量爬取，完整内容需要通过一次人机验证后展开。验证后 12 小时内无需重复验证。</p><button class="primary-button" type="button" data-open-unlock>展开全部</button></div></div>}
</div>
<div class="unlock-modal" data-unlock-modal hidden role="dialog" aria-modal="true" aria-label="展开完整内容">
  <div class="modal-backdrop" data-close-unlock></div>
  <section class="modal-card">
    <div class="modal-head"><h2>展开完整内容</h2><button class="icon-button" type="button" data-close-unlock aria-label="关闭">×</button></div>
    <p>为了减少批量爬取和恶意访问，请先完成人机验证。</p>
    <div class="turnstile-box" data-turnstile-box>正在加载验证配置...</div>
    <p class="unlock-message" data-unlock-message></p>
  </section>
</div>
<script is:inline>
(() => {
  const gate = document.querySelector('[data-doc-gate]');
  const content = document.querySelector('[data-doc-content]');
  const fade = document.querySelector('[data-doc-fade]');
  const modal = document.querySelector('[data-unlock-modal]');
  const message = document.querySelector('[data-unlock-message]');
  const turnstileBox = document.querySelector('[data-turnstile-box]');
  let siteKey = '';
  let loadingConfig = null;
  let verifyingToken = false;
  function unlock() { content?.classList.remove('collapsed'); fade?.remove(); modal.hidden = true; }
  async function checkStatus() {
    try { const res = await fetch('/api/unlock/status'); const data = await res.json(); if (data.unlocked) unlock(); } catch (_) {}
  }
  async function loadConfig() {
    if (siteKey) return siteKey;
    if (!loadingConfig) {
      loadingConfig = fetch('/api/turnstile/config')
        .then((res) => res.json())
        .then((data) => {
          siteKey = data.siteKey || '';
          return siteKey;
        })
        .catch(() => '');
    }
    return loadingConfig;
  }
  async function verify(token) {
    if (!token || verifyingToken) return;
    verifyingToken = true;
    message.textContent = '正在验证...';
    try {
      const res = await fetch('/api/turnstile/verify', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ token }) });
      const data = await res.json();
      if (data.ok) { message.textContent = '验证通过，已展开全文。'; unlock(); return; }
      message.textContent = data.message || '验证失败，请刷新后重试。';
    } catch (_) { message.textContent = '网络异常，请稍后重试。'; }
    finally { verifyingToken = false; }
  }
  function verifyHiddenResponse() {
    const input = turnstileBox?.querySelector('input[name="cf-turnstile-response"]');
    const token = input?.value;
    if (token) verify(token);
  }
  async function loadTurnstile() {
    await loadConfig();
    if (!siteKey) {
      turnstileBox.textContent = location.hostname === 'localhost' || location.hostname === '127.0.0.1'
        ? '本地尚未配置 PUBLIC_TURNSTILE_SITE_KEY。开发环境可直接解锁预览。'
        : '站点暂未配置 Turnstile Site Key，请稍后重试。';
      if ((location.hostname === 'localhost' || location.hostname === '127.0.0.1') && !document.querySelector('[data-dev-unlock]')) {
        const button = document.createElement('button');
        button.className = 'secondary-button';
        button.type = 'button';
        button.dataset.devUnlock = '';
        button.textContent = '开发环境解锁';
        button.addEventListener('click', unlock);
        turnstileBox.after(button);
      }
      return;
    }
    if (!siteKey || window.turnstile) {
      if (window.turnstile && turnstileBox && !turnstileBox.dataset.rendered) {
        turnstileBox.textContent = '';
        window.turnstile.render(turnstileBox, {
          sitekey: siteKey,
          callback: verify,
          'error-callback': () => {
            message.textContent = 'Turnstile 无法连接到验证服务。请关闭广告拦截/代理后刷新，或换一个网络重试。';
          },
          'timeout-callback': () => {
            message.textContent = '验证超时，请刷新后重试。';
          },
        });
        turnstileBox.dataset.rendered = 'true';
        setTimeout(verifyHiddenResponse, 1200);
        setTimeout(verifyHiddenResponse, 3000);
      }
      return;
    }
    const script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
    script.async = true; script.defer = true; script.onload = loadTurnstile;
    document.head.appendChild(script);
  }
  if (gate?.dataset.unlockRequired === 'false') unlock(); else checkStatus();
  document.querySelector('[data-open-unlock]')?.addEventListener('click', () => { modal.hidden = false; loadTurnstile(); });
  document.querySelectorAll('[data-close-unlock]').forEach((el) => el.addEventListener('click', () => { modal.hidden = true; }));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && modal && !modal.hidden) modal.hidden = true; });
})();
</script>

<script is:inline>
/* Lazy mathematical typesetting, with multiple CDNs and unstyled source fallback. */
(() => {
  const content = document.querySelector('[data-doc-content]');
  if (!content || !content.textContent?.includes('$$')) return;
  const css = document.createElement('style');
  css.textContent = '.doc-content .katex-display{max-width:100%;overflow-x:auto;overflow-y:hidden;padding:9px 0 15px}.doc-content .katex{font-size:1.08em}';
  document.head.appendChild(css);
  const providers = [
    {base:'https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/'},
    {base:'https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.22/'},
    {base:'https://unpkg.com/katex@0.16.22/dist/'}
  ];
  function addStyle(url) {
    const existing = document.getElementById('journal-katex-css');
    if (existing) existing.remove();
    const link = document.createElement('link');
    link.id = 'journal-katex-css';
    link.rel = 'stylesheet';
    link.href = url;
    document.head.appendChild(link);
  }
  function script(url) {
    return new Promise((resolve, reject) => {
      const node = document.createElement('script');
      node.src = url;
      node.async = true;
      node.onload = () => resolve();
      node.onerror = () => reject(new Error('CDN unavailable'));
      document.head.appendChild(node);
    });
  }
  (async () => {
    for (const provider of providers) {
      try {
        addStyle(provider.base + 'katex.min.css');
        if (!window.katex) await script(provider.base + 'katex.min.js');
        if (!window.renderMathInElement) await script(provider.base + 'contrib/auto-render.min.js');
        if (typeof window.renderMathInElement !== 'function') continue;
        window.renderMathInElement(content, {
          delimiters: [
            {left:'$$', right:'$$', display:true},
            {left:'\\(', right:'\\)', display:false}
          ],
          throwOnError:false,
          strict:'ignore',
          ignoredTags:['script','noscript','style','textarea','pre','code']
        });
        break;
      } catch {
        // Retain readable LaTeX and plain-text equations if an external source is blocked.
      }
    }
  })();
})();
</script>
